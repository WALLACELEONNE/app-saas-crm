FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi>=0.135.0 \
    uvicorn[standard] \
    motor>=3.7.0 \
    pymongo>=4.17.0 \
    pydantic>=2.13.0 \
    pydantic-settings>=2.14.0 \
    python-dotenv \
    python-jose[cryptography] \
    "passlib[bcrypt]==1.7.4" \
    "bcrypt==4.0.1" \
    python-multipart \
    httpx \
    email-validator

COPY backend/ .

RUN mkdir -p emergentintegrations/llm && \
    cp emergentintegrations.py emergentintegrations/__init__.py && \
    cp emergentintegrations.py emergentintegrations/llm/chat.py

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
